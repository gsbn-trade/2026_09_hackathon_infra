# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored —
# it's not secret by itself, but keep it out of version control anyway.

region              = "cn-hongkong"
admin_cidr          = "203.0.113.10/32" # your current public IP — https://ifconfig.me
ssh_public_key_path = "~/.ssh/id_ed25519.pub"
instance_type       = "ecs.g9i.xlarge"
