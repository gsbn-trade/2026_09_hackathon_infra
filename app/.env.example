# Copy to .env and fill in real values. .env is gitignored.
# Generate the two litellm secrets with: openssl rand -hex 32

# Leave blank for local dev (Caddy is skipped; hit litellm/boltdiy directly
# on localhost, see README). Set to "cloud" on the VM to turn Caddy on.
COMPOSE_PROFILES=

POSTGRES_PASSWORD=
LITELLM_MASTER_KEY=sk-admin-
LITELLM_SALT_KEY=

# Bailian (Model Studio) key — Qwen.
DASHSCOPE_API_KEY=

# One bolt.diy virtual key per team (team0 = organizer testing only) — mint
# all of them at once with scripts/mint-team-keys.sh once litellm is up, or
# by hand via README step 5's curl pattern. Leave blank until minted; fill
# in, then `docker compose up -d boltdiy-teamN` (or --profile organizer for
# team0) to pick it up.
TEAM0_VIRTUAL_KEY=
TEAM1_VIRTUAL_KEY=
TEAM2_VIRTUAL_KEY=
TEAM3_VIRTUAL_KEY=
TEAM4_VIRTUAL_KEY=
TEAM5_VIRTUAL_KEY=

# Open WebUI (data understanding/analysis, see README) — separate virtual
# key from bolt.diy's, same pattern: mint via /key/generate, fill in, then
# `docker compose up -d open-webui`.
OPENWEBUI_VIRTUAL_KEY=
# Open WebUI's own session/cookie signing secret — unrelated to LiteLLM.
# openssl rand -hex 32
OPENWEBUI_SECRET_KEY=

# Auth token between Open WebUI and its Jupyter code-interpreter backend —
# internal to this stack, never exposed to participants. openssl rand -hex 24
JUPYTER_TOKEN=

# One DeepSeek Harness virtual key per team (team0 = organizer testing
# only) — same mint-a-virtual-key pattern as the TEAMn_VIRTUAL_KEY vars
# above, minted alongside them by scripts/mint-team-keys.sh. Referenced from
# each deepseek-harness-teamN's own environment (docker-compose.yml), which
# in turn is what deepseek-harness/home-teamN/settings.yaml's apiKeyEnv
# reads inside that container — not read directly by Compose.
TEAM0_DSH_VIRTUAL_KEY=
TEAM1_DSH_VIRTUAL_KEY=
TEAM2_DSH_VIRTUAL_KEY=
TEAM3_DSH_VIRTUAL_KEY=
TEAM4_DSH_VIRTUAL_KEY=
TEAM5_DSH_VIRTUAL_KEY=

# A real DeepSeek platform key (platform.deepseek.com — Chinese account or
# international both work), NOT a Bailian/DashScope key and NOT any virtual
# key above. Only used for web search: dsh-web-search-deepseek calls
# api.deepseek.com's own Anthropic-compatible API directly with DeepSeek's
# native web_search server tool, bypassing LiteLLM entirely — see
# docs/deepseek-harness/README.md. Leave blank to run with web search
# disabled (confirmed failure mode: "no usable web provider is registered",
# not a crash) — everything else in the app works without it. Shared across
# every team's DeepSeek Harness instance — it's a read-only tool
# credential, not a spend-tracked one, so team isolation doesn't apply here
# the way it does for the LiteLLM virtual keys above.
DEEPSEEK_API_KEY=

# HTTP Basic Auth passphrase hashes gating each public subdomain (see
# Caddyfile) — one per team (team0 = organizer testing), plus one shared
# passphrase for the Open WebUI backup instance. Generate all of these,
# plaintext passphrases included, with scripts/generate-team-auth.sh — it
# writes the bcrypt hashes here and prints the plaintext passphrases to
# share with teams out-of-band (never commit the plaintext; see
# team-credentials.txt in .gitignore). Caddy reads these via its Caddyfile's
# {$VAR} substitution, passed through in docker-compose.yml's caddy service.
TEAM0_BASIC_AUTH_HASH=
TEAM1_BASIC_AUTH_HASH=
TEAM2_BASIC_AUTH_HASH=
TEAM3_BASIC_AUTH_HASH=
TEAM4_BASIC_AUTH_HASH=
TEAM5_BASIC_AUTH_HASH=
OPENWEBUI_BASIC_AUTH_HASH=
