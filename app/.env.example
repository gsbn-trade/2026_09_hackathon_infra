# Copy to .env and fill in real values. .env is gitignored.
# Generate the two litellm secrets with: openssl rand -hex 32

# Leave blank for local dev (Caddy is skipped; hit litellm/boltdiy directly
# on localhost, see README). Set to "cloud" on the VM to turn Caddy on.
COMPOSE_PROFILES=

POSTGRES_PASSWORD=
LITELLM_MASTER_KEY=sk-admin-
LITELLM_SALT_KEY=

# Bailian (Model Studio) key — Qwen.
DASHSCOPE_API_KEY=

# Leave blank on first deploy. Fill in AFTER litellm is up and you've minted
# a team virtual key (README step 5), then `docker compose up -d boltdiy`
# to pick it up.
TEAM_VIRTUAL_KEY=
