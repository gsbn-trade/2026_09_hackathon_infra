.env

# Runtime storage created by the various services (app files, plugin
# packages, certbot certs, etc.) — not upstream source. sandbox/conf/ is
# the one exception: those are real vendored config templates, not
# runtime data, so keep them tracked.
volumes/*
!volumes/sandbox/
volumes/sandbox/*
!volumes/sandbox/conf/

# config.yaml (not config.yaml.example) carries the real sandbox API key —
# same secrets-stay-out-of-git pattern as .env above. Copy
# config.yaml.example to config.yaml locally and set `app.key` to match
# .env's SANDBOX_API_KEY (this file is a plain volume mount, not passed
# through docker-compose var substitution, so it can't just read the .env
# value itself).
volumes/sandbox/conf/config.yaml
