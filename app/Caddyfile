# Replace hack.gsbn.trade with your real domain once DNS is pointed at the
# EIP from `terraform output public_ip`. Caddy issues and renews Let's
# Encrypt certs for these automatically — nothing else to do.
#
# bolt.diy's in-browser sandbox (WebContainers) requires a genuine HTTPS
# secure context to work at all — a bare IP over plain HTTP will not run it.
# A domain name is not optional for the buildN.* hosts.
#
# Every team-facing subdomain below is gated by HTTP Basic Auth (one
# username/passphrase per team: "team1".."team5", plus "team0" for
# organizer testing) — these are public, internet-reachable URLs handed to
# people this project has no accounts for, and DeepSeek Harness in
# particular has no login wall of its own (see docs/deepseek-harness/).
# Passphrase hashes come from app/.env via Caddy's {$VAR} substitution
# (resolved from the caddy service's own environment, see
# docker-compose.yml) — generate them with scripts/generate-team-auth.sh,
# which also prints the plaintext passphrases to share with teams
# out-of-band (never commit them; see app/.gitignore).

gateway.hack.gsbn.trade {
	reverse_proxy litellm:4000
}

# --- bolt.diy: one subdomain per team, same Basic Auth username as its
# DeepSeek Harness subdomain below, so each team only has to remember one
# passphrase for both of its tools.

build0.hack.gsbn.trade {
	basic_auth {
		team0 {$TEAM0_BASIC_AUTH_HASH}
	}
	reverse_proxy boltdiy-team0:5173
}

build1.hack.gsbn.trade {
	basic_auth {
		team1 {$TEAM1_BASIC_AUTH_HASH}
	}
	reverse_proxy boltdiy-team1:5173
}

build2.hack.gsbn.trade {
	basic_auth {
		team2 {$TEAM2_BASIC_AUTH_HASH}
	}
	reverse_proxy boltdiy-team2:5173
}

build3.hack.gsbn.trade {
	basic_auth {
		team3 {$TEAM3_BASIC_AUTH_HASH}
	}
	reverse_proxy boltdiy-team3:5173
}

build4.hack.gsbn.trade {
	basic_auth {
		team4 {$TEAM4_BASIC_AUTH_HASH}
	}
	reverse_proxy boltdiy-team4:5173
}

build5.hack.gsbn.trade {
	basic_auth {
		team5 {$TEAM5_BASIC_AUTH_HASH}
	}
	reverse_proxy boltdiy-team5:5173
}

# --- DeepSeek Harness: one subdomain per team. Routes to the *owner*
# service name (deepseek-harness-teamN), not its -proxy sidecar — the proxy
# shares that service's network namespace instead of getting a network
# identity of its own, so Docker's internal DNS only resolves the owner's
# name (see docker-compose.yml's comment on this).
#
# /files/* on each of these is a plain static browser over that team's own
# workspace-teamN directory (mounted read-only into *this* caddy container,
# see docker-compose.yml) — added 2026-09-02 because dsh's own
# host.openPath (the UI's "open this generated file" action) is
# permanently loopback-only by upstream design (not something
# --trusted-host can unlock — see docs/deepseek-harness/README.md), and a
# headless container has no desktop to open a file on anyway. This gives
# teams an actual way to view/download what the agent generates
# (index.html, .md reports, etc.) without touching that restricted API at
# all — same Basic Auth as the rest of the host, since basic_auth applies
# per-host regardless of path.

team0.hack.gsbn.trade {
	basic_auth {
		team0 {$TEAM0_BASIC_AUTH_HASH}
	}
	handle_path /files/* {
		root * /srv/files/team0
		file_server browse
	}
	handle {
		reverse_proxy deepseek-harness-team0:8080
	}
}

team1.hack.gsbn.trade {
	basic_auth {
		team1 {$TEAM1_BASIC_AUTH_HASH}
	}
	handle_path /files/* {
		root * /srv/files/team1
		file_server browse
