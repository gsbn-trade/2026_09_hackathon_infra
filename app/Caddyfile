# Data understanding/analysis (Open WebUI) — single shared/backup instance,
# not per-team. Gated with one shared passphrase (username "guest") rather
# than left wide open: it's a public, unauthenticated-by-default app
# (WEBUI_AUTH=False, see docker-compose.yml) sitting in front of a paid
# model budget, and this project doesn't know every hackathon participant
# ahead of time — anyone who finds the URL without this gate could spend
# against the shared LiteLLM budget.
analyze.hack.gsbn.trade {
	basic_auth {
		guest {$OPENWEBUI_BASIC_AUTH_HASH}
	}
	reverse_proxy open-webui:8080
}

